MC_USERNAME=your_username
MC_PASSWORD=your_password
MC_HOST=mc.example.com
MC_AUTH_SERVER=https://drasl.example.com/auth
MC_SESSION_SERVER=https://drasl.example.com/session
# Optional: pin the protocol version (leave unset for autoVersion). Set this to
# a mineflayer-supported version when the server runs a newer one behind
# ViaVersion/ViaBackwards, e.g. MC_VERSION=1.21.11 for a 26.x server.
MC_VERSION=
